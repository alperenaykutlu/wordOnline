# ════════════════════════════════════════════════
#   WORDLE ONLINE — ENVIRONMENT VARIABLES
#   Bu dosyayı .gitignore'a ekleyin!
#   cp .env.example .env ile başlayın.
# ════════════════════════════════════════════════

# ─── Docker Compose değişkenleri ─────────────────
# Bu bloktakiler docker-compose.yml tarafından container'lara aktarılır.

APP_ENV=Development

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme

# Redis
REDIS_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USER=wordle_app
RABBITMQ_PASS=changeme

# JWT — en az 32 karakter!
JWT_SECRET_KEY=BURAYA_EN_AZ_32_KARAKTER_GUCLU_BIR_KEY

# Google Sign-In
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ─── Local API (dotnet run) ──────────────────────
# Docker kullanmadan `dotnet run --project src/WordleOnline.API` için.

JWT__SecretKey=BURAYA_EN_AZ_32_KARAKTER_GUCLU_BIR_KEY
JWT__Issuer=wordle-online
JWT__Audience=wordle-mobile
JWT__AccessTokenExpiryMinutes=15
JWT__RefreshTokenExpiryDays=7

MongoDB__ConnectionString=mongodb://admin:changeme@localhost:27017/wordle_prod?authSource=admin
MongoDB__DatabaseName=wordle_prod

Redis__ConnectionString=localhost:6379,password=changeme,ssl=false

RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=wordle_app
RabbitMQ__Password=changeme

Google__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

Cors__Origins=https://yourdomain.com,http://localhost:3000

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://+:5001;http://+:5000

# ─── Google Play Billing ──────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.wordleonline
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── React Native (AdMob) ─────────────────────────
GOOGLE_ADS_BANNER_ID=ca-app-pub-xxxxxxxx/xxxxxxxxxx
GOOGLE_ADS_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxxxx
